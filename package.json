{
  "name": "zenthrip",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/anmolkumar875511/Zenthrip#readme",
  "bugs": {
    "url": "https://github.com/anmolkumar875511/Zenthrip/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anmolkumar875511/Zenthrip.git"
  },
  "author": "Anmol Kumar",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.tessaractzero.zenthrip",
    "productName": "Zenthrip",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "engines": {
    "node": ">=22.22"
  },
  "allowScripts": {
    "electron@45.0.0": true
  }
}
